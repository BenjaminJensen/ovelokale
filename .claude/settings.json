{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec frontend npm:*)",
      "Bash(docker compose exec -T frontend npm:*)",
      "Bash(docker compose exec web php:*)",
      "Bash(docker compose exec -T web php:*)",
      "Bash(docker compose exec web composer:*)",
      "Bash(docker compose exec -T web composer:*)",
      "Bash(docker compose run --rm playwright:*)",
      "Bash(docker compose run --rm --no-deps playwright:*)",
      "Bash(./scripts/e2e.sh:*)",
      "Bash(curl -s http://localhost:8080/api/:*)",
      "Bash(curl -s http://localhost:5173/:*)"
    ]
  }
}
